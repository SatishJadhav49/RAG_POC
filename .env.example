# --- Azure AI Foundry / Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_EMBED_DEPLOYMENT=text-embedding-3-large
EMBED_DIM=1024

# Set to 1 to run the whole pipeline with a fake local embedder (no Azure calls).
# Useful to smoke-test ingest/search before credentials are available.
OFFLINE_EMBED=0

DATA_FILE=data/defects.xlsx
INDEX_DIR=index
